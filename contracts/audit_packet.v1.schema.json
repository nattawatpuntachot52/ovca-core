{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditPacketV1",
  "description": "Structural wire validation only. Rust AuditPacketV1::validate and the A05 controller are authoritative for exact review-result and independence bindings.",
  "x-ovca-schema-role": "structural_wire_only",
  "x-ovca-semantic-validator": "ovca_types::independent_review::AuditPacketV1::validate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "packet_id", "review_packet", "review_packet_digest", "review_result_digest", "review_decision", "auditor", "auditor_invocation", "auditor_invocation_digest", "evidence_manifest", "packet_digest"],
  "properties": {
    "contract_version": { "const": 1 },
    "packet_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "review_packet": { "$ref": "review_packet.v1.schema.json" },
    "review_packet_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "review_result_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "review_decision": { "$ref": "#/$defs/reviewDecision" },
    "auditor": { "$ref": "foundation_authority.v1.schema.json#/$defs/principalIdentity" },
    "auditor_invocation": { "$ref": "control_plane_role_invocation.v1.schema.json" },
    "auditor_invocation_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "evidence_manifest": { "$ref": "review_packet.v1.schema.json#/$defs/evidenceManifest" },
    "packet_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" }
  },
  "$defs": {
    "nonblank": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "kind", "criterion", "verdict", "evidence_refs", "rationale"],
      "properties": {
        "contract_version": { "const": 1 }, "kind": { "enum": ["acceptance", "verification", "definition_of_done"] },
        "criterion": { "$ref": "#/$defs/nonblank" }, "verdict": { "enum": ["satisfied", "unsatisfied"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" } },
        "rationale": { "$ref": "#/$defs/nonblank" }
      }
    },
    "reviewDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "id", "run_id", "goal_id", "producer_role", "verdict", "assessments", "summary", "decided_at"],
      "properties": {
        "contract_version": { "const": 1 }, "id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
        "run_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" }, "goal_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
        "producer_role": { "const": "reviewer" }, "verdict": { "enum": ["pass", "fail"] },
        "assessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessment" } },
        "summary": { "$ref": "#/$defs/nonblank" }, "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
