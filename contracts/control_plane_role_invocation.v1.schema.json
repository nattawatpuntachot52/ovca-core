    "invocation_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "invoker": { "$ref": "foundation_authority.v1.schema.json#/$defs/principalIdentity" },
    "target": { "$ref": "foundation_authority.v1.schema.json#/$defs/principalIdentity" },
    "task_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "run_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
