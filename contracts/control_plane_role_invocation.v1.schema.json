    "idempotency_key": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "authority": { "$ref": "foundation_authority.v1.schema.json" },
    "authority_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
