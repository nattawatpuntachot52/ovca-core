{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepairDirectiveV1",
  "description": "Structural wire validation only. A directive grants no authority and Rust RepairDirectiveV1::validate is authoritative for the single-successor chain and digest.",
  "x-ovca-schema-role": "structural_wire_only",
  "x-ovca-semantic-validator": "ovca_types::independent_review::RepairDirectiveV1::validate",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "directive_id", "root_run_id", "failed_run_id", "successor_run_id", "goal_id", "task_id", "failed_candidate_cycle", "successor_candidate_cycle", "max_repair_cycles", "review_packet_digest", "review_result_digest", "audit_packet_digest", "audit_result_digest", "repair_paths", "unsatisfied_criteria", "routed_by", "grants_authority", "directive_digest"],
  "allOf": [
    {
      "if": { "properties": { "failed_candidate_cycle": { "const": 0 } }, "required": ["failed_candidate_cycle"] },
      "then": { "not": { "required": ["prior_repair_directive_digest"] } },
      "else": { "required": ["prior_repair_directive_digest"] }
    }
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "directive_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "root_run_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "failed_run_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "successor_run_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "goal_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "task_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "failed_candidate_cycle": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "successor_candidate_cycle": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "max_repair_cycles": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "prior_repair_directive_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "review_packet_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "review_result_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "audit_packet_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "audit_result_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "repair_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "unsatisfied_criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/unsatisfiedCriterion" } },
    "routed_by": { "$ref": "foundation_authority.v1.schema.json#/$defs/principalIdentity" },
    "grants_authority": { "const": false },
    "directive_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" }
  },
  "$defs": {
    "unsatisfiedCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "criterion"],
      "properties": {
        "kind": { "enum": ["acceptance", "verification", "definition_of_done"] },
        "criterion": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
