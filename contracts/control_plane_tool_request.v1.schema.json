{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolRequestV1",
  "description": "Structural wire validation only. Rust ToolRequestV1 validation and same-broker registry resolution are authoritative; requested_at is trace-only and write bytes remain out of band.",
  "x-ovca-schema-role": "structural_wire_only",
  "x-ovca-semantic-validator": "ovca_types::tool_boundary::ToolRequestV1::validate and ovca_runtime_core::workspace_capability::WorkspaceCapabilityBroker::execute",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "idempotency_key", "invocation_id", "invocation_digest", "attempt", "grant_id", "grant_digest", "lease_id", "lease_digest", "workspace_id", "expected_snapshot_digest", "requester", "scope", "operation", "requested_at"],
  "properties": {
    "contract_version": { "const": 1 },
    "request_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "idempotency_key": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "invocation_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "invocation_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "grant_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "grant_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "lease_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "lease_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "workspace_id": { "$ref": "foundation_authority.v1.schema.json#/$defs/stableId" },
    "expected_snapshot_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
    "requester": { "$ref": "foundation_authority.v1.schema.json#/$defs/principalIdentity" },
    "scope": { "$ref": "foundation_authority.v1.schema.json#/$defs/scope" },
    "operation": { "$ref": "#/$defs/toolOperation" },
    "requested_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=.{1,512}$)(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))[A-Za-z0-9._-]{1,128}(?:/[A-Za-z0-9._-]{1,128}){0,31}(?![\\s\\S])",
      "x-ovca-semantic-path": "portable_ascii_no_dot_dot_reserved_trailing_dot_or_case_alias"
    },
    "readFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "logical_path"],
      "properties": {
        "type": { "const": "read_file" },
        "logical_path": { "$ref": "#/$defs/logicalPath" }
      }
    },
    "writeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "logical_path", "content_sha256", "byte_length"],
      "properties": {
        "type": { "const": "write_file" },
        "logical_path": { "$ref": "#/$defs/logicalPath" },
        "content_sha256": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "intent_digest"],
      "properties": {
        "type": { "const": "unsupported" },
        "kind": { "enum": ["command", "environment", "network", "delete", "rename", "copy", "create_directory", "link"] },
        "intent_digest": { "$ref": "foundation_authority.v1.schema.json#/$defs/sha256Digest" }
      }
    },
    "toolOperation": {
      "oneOf": [
        { "$ref": "#/$defs/readFile" },
        { "$ref": "#/$defs/writeFile" },
        { "$ref": "#/$defs/unsupported" }
      ]
    }
  }
}
